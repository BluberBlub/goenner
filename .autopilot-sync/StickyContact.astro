---
// @LOCKED v6 – Sticky-Contact mit KORREKTER Logik (v4: Schriftfarbe automatisch, text-on-accent):
// Verzögerung als eigener Zustand (überschreibt NICHT den Observer),
// versteckt bei Hero/CTA/Footer UND offenem Cookie-Banner. Border gegen Verschmelzen.
// v5 (Spöri, Weber: "Titel langweilig, Icon unpassend", "immer projektbezogen anpassen"):
//     Text und Icon über site-data.json: "sticky": { "titel", "zeile", "icon", "href" }.
//     icon: "chat" (Standard) | "pfeil" | "telefon" | "kalender" | "keins" | eigener SVG-Pfad ("<path d=…/>").
//     "zeile" = kleine Zeile über dem Titel. Ohne "sticky"-Eintrag sieht alles aus wie in v4.
//     Radius aus design.radius.
// v6 (Waldsee Golf, Niko): auf seiner eigenen Zielseite (z. B. /kontakt/) erscheint der Knopf nicht. Dort verdeckte er
//     auf dem Handy das Formular, auf das er selbst verweist.
import siteData from '../content/site-data.json';
const tel = siteData.kontakt?.telefon;
const cfg = ((siteData as Record<string, unknown>).sticky ?? {}) as { titel?: string; zeile?: string; icon?: string; href?: string };
const ziel = cfg.href ?? '/kontakt/';
const titel = cfg.titel ?? 'Kontakt';
const zeile = cfg.zeile;
const icon = cfg.icon ?? 'chat';
const icons: Record<string, string> = {
  chat: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  pfeil: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  telefon: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/>',
  kalender: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
};
const pfad = icon.trim().startsWith('<') ? icon : icons[icon];
const ohneSlash = (h: string) => h.replace(/[?#].*$/, '').replace(/\/$/, '') || '/';
const aufZiel = ohneSlash(Astro.url.pathname) === ohneSlash(ziel);
---
{!aufZiel && (
<div id="sticky-contact" aria-hidden="true" inert
     class="fixed right-5 z-40 opacity-0 translate-y-4 pointer-events-none transition-all duration-300"
     style="bottom: calc(1.25rem + var(--demo-bar-h, 0px))">
  <a href={ziel}
     class="group flex items-center gap-3 bg-accent text-on-accent font-semibold pl-4 pr-5 py-3 rounded-[var(--radius-knopf,9999px)] shadow-xl border border-white/25 hover:scale-105 transition-transform">
    {/* v5.1 (Schwabenpflege): Icon so hoch wie der Text daneben, zweizeilig 2.4rem, sonst 1.25rem */}
    {pfad && icon !== 'pfeil' && <svg class:list={['shrink-0', zeile ? 'h-[2.4rem] w-[2.4rem]' : 'h-5 w-5']} width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={pfad} />}
    <span class="flex flex-col leading-tight text-left">
      {zeile && <span class="text-[0.68rem] font-semibold uppercase tracking-[0.14em] opacity-70">{zeile}</span>}
      <span>{titel}</span>
    </span>
    {icon === 'pfeil' && <svg class="transition-transform group-hover:translate-x-1" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true" set:html={pfad} />}
  </a>
</div>
)}

<script>
  const sticky = document.getElementById('sticky-contact');
  if (sticky) {
    let heroVisible = true, footerVisible = false, ctaVisible = false, delayPassed = false;

    const cookieOffen = () => {
      const b = document.getElementById('cookie-banner');
      if (!b) return false;
      const cs = getComputedStyle(b);
      return cs.display !== 'none' && parseFloat(cs.opacity) > 0.1;
    };

    const update = () => {
      const hide = !delayPassed || heroVisible || footerVisible || ctaVisible || cookieOffen();
      sticky.classList.toggle('opacity-0', hide);
      sticky.classList.toggle('translate-y-4', hide);
      sticky.classList.toggle('pointer-events-none', hide);
      // Ausgeblendet = auch für Tastatur und Screenreader weg (Schwabenpflege: unsichtbare fixe Knöpfe)
      sticky.toggleAttribute('inert', hide);
      if (hide) sticky.setAttribute('aria-hidden', 'true'); else sticky.removeAttribute('aria-hidden');
    };

    setTimeout(() => { delayPassed = true; update(); }, 2000);

    const hero = document.querySelector('main > section:first-of-type');
    const footer = document.querySelector('footer');
    const sections = document.querySelectorAll('main > section');
    const cta = sections.length > 1 ? sections[sections.length - 1] : null;

    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.target === hero) heroVisible = e.isIntersecting;
        if (e.target === footer) footerVisible = e.isIntersecting;
        if (e.target === cta) ctaVisible = e.isIntersecting;
      });
      update();
    }, { threshold: 0.01 });
    [hero, footer, cta].filter(Boolean).forEach(el => io.observe(el));

    window.addEventListener('cookieconsent', update);
    const cb = document.getElementById('cookie-banner');
    if (cb) new MutationObserver(update).observe(cb, { attributes: true, attributeFilter: ['style', 'class'] });
    update();
  }
</script>
