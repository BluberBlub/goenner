# Praxis Dr. Gönner – Apache-Konfiguration
ErrorDocument 404 /404.html
Options -Indexes

# HTTPS erzwingen erst nach TLS-Test (phase5-deploy.md)
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# Alte URLs der bisherigen Website auf die neuen Seiten (Relaunch, SEO)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^Start/?$ / [R=301,L,NC]
  RewriteRule ^Politik/?$ /fachliches/versorgung-in-not/ [R=301,L,NC]
  RewriteRule ^Therapeuten/Qualifikationen/?$ /team/ [R=301,L,NC]
  RewriteRule ^Therapeuten/Mitgliedschaften/?$ /team/#mitgliedschaften [R=301,L,NC,NE]
  RewriteRule ^Therapeuten(/Team)?/?$ /team/ [R=301,L,NC]
  RewriteRule ^Behandlung/(Therapiekonzept|Schwerpunkte)/?$ /behandlung/therapie-und-schwerpunkte/ [R=301,L,NC]
  RewriteRule ^Behandlung/(Prozedere|Kosten)/?$ /behandlung/ablauf-und-kosten/ [R=301,L,NC]
  RewriteRule ^Behandlung/?$ /behandlung/ [R=301,L]
  RewriteRule ^Stellenangebote/?$ /fachliches/stellenangebote/ [R=301,L]
  RewriteRule ^AOK-und-BKK/?$ /behandlung/aok-und-bkk/ [R=301,L]
  RewriteRule ^Supervision-Lehre/?$ /fachliches/supervision-und-lehre/ [R=301,L,NC]
  RewriteRule ^Selbstzahler/?$ /behandlung/ablauf-und-kosten/#selbstzahler [R=301,L,NC,NE]
  RewriteRule ^Praxisraeume/Kunst-im-Wartezimmer/?$ /praxis/#kunst [R=301,L,NC,NE]
  RewriteRule ^Praxisraeume/?$ /praxis/ [R=301,L,NC]
  RewriteRule ^Kontakt/So-finden-Sie-uns/?$ /praxis/#anfahrt [R=301,L,NC,NE]
  RewriteRule ^Kontakt(/Kontakt-Anmeldung)?/?$ /kontakt/ [R=301,L]
  RewriteRule ^Impressum-Datenschutz/Datenschutz/?$ /datenschutz/ [R=301,L,NC]
  RewriteRule ^Impressum-Datenschutz(/Impressum)?/?$ /impressum/ [R=301,L,NC]
  RewriteRule ^(ablauf-und-kosten|aok-und-bkk)/?$ /behandlung/$1/ [R=301,L]
  RewriteRule ^(supervision-und-lehre|versorgung-in-not|stellenangebote)/?$ /fachliches/$1/ [R=301,L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/avif "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/xml image/svg+xml application/json
</IfModule>

<Files ".env.php">
  Require all denied
</Files>
