---
// Hinweis für akute Krisen. Empfehlung "psychiatrische Klinik" stammt von der Altseite (Kontraindikationen),
// die Rufnummern sind bundesweite öffentliche Notrufe (in OFFENE-FRAGEN.md zur Bestätigung notiert).
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<aside class:list={['rounded-karte border border-primary/20 bg-background p-6 sm:p-8', cls]} aria-label="Hilfe in einer akuten Krise">
  <p class="etikett text-primary">In einer akuten Krise</p>
  <p class="mt-3 leading-relaxed text-text/85">
    Wir sind keine Notfallpraxis. Wenn Sie nicht sicher sind, ob Sie sich etwas antun könnten, wenden Sie sich bitte direkt oder über Ihren Hausarzt oder Psychiater an eine psychiatrische Klinik. Im Notfall erreichen Sie jederzeit den Rettungsdienst unter <a href="tel:112" class="font-semibold underline underline-offset-4">112</a>, die Telefonseelsorge rund um die Uhr kostenfrei unter <a href="tel:+498001110111" class="whitespace-nowrap font-semibold underline underline-offset-4">0800 111 0 111</a>.
  </p>
</aside>
