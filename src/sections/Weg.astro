---
// Der Weg in vier Schritten (Octave "path to care"), Fakten aus /Behandlung/Prozedere und /Kontakt.
// Ein geschwungener Pfad zeichnet sich beim Scrollen über die vier Wegmarken (CSS .weg-linie),
// jede Marke füllt sich, sobald der Pfad sie erreicht. Botschaft: Der Weg wird Schritt für Schritt sichtbar.
import Section from '../components/Section.astro';
import SektionsKopf from '../components/SektionsKopf.astro';

interface Props { kompakt?: boolean }
const { kompakt = false } = Astro.props;

const schritte = [
  { nr: '01', titel: 'Anfrage', text: 'Am besten über unser Kontaktformular oder in der telefonischen Sprechzeit am Donnerstag von 13:00 bis 14:00 Uhr.' },
  { nr: '02', titel: 'Sprechstunde und Probesitzungen', text: 'Wir lernen Ihre Beschwerden kennen, klären die Diagnose und ob eine ambulante Psychotherapie das Richtige für Sie ist. Und Sie prüfen, ob die Chemie stimmt.' },
  { nr: '03', titel: 'Antrag bei der Krankenkasse', text: 'Entscheiden wir uns gemeinsam für eine Therapie, stellen wir den Antrag auf Kostenübernahme. Begonnen wird nach der Bewilligung.' },
  { nr: '04', titel: 'Therapie', text: 'Sitzungen von 50 Minuten, meist wöchentlich zu einem festen Termin. Eine Kurzzeittherapie umfasst 24 Sitzungen.' },
];
---
<Section variant="standard" bg="base">
  <div class="relative">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-8">
      <div class="lg:col-span-6">
        <SektionsKopf eyebrow="Ablauf" titel="Ihr Weg zu uns, in vier Schritten." groesse="mittel" class="!mb-0"
          text="Gesetzlich Versicherte bringen zum ersten Termin nur ihre Versichertenkarte mit, dazu vorhandene Arzt- oder Klinikberichte." />
      </div>
    </div>
    <div class="weg-pfad relative mt-10 hidden h-20 lg:mt-14 lg:block" aria-hidden="true">
      <svg class="absolute inset-0 h-full w-full overflow-visible text-primary" viewBox="0 0 1000 80" preserveAspectRatio="none" fill="none">
        <path class="weg-spur" d="M0 40C62 8 188 72 250 40S438 8 500 40S688 72 750 40S938 8 1000 40" stroke="currentColor" stroke-opacity=".18" stroke-width="1.5" vector-effect="non-scaling-stroke" stroke-dasharray="3 6" />
        <path class="weg-linie" pathLength="1" d="M0 40C62 8 188 72 250 40S438 8 500 40S688 72 750 40S938 8 1000 40" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
      {schritte.map((s, i) => <span class="weg-punkt" style={`left:${i * 25}%;--i:${i}`}>{i + 1}</span>)}
    </div>
    <ol class="mt-8 grid lg:mt-0 lg:grid-cols-4">
      {schritte.map((s) => (
        <li class="weg-schritt py-6 lg:px-7 lg:py-8 first:lg:pl-0 last:lg:pr-0" data-reveal>
          <span class="etikett text-primary/70">Schritt {s.nr}</span>
          <h3 class="mt-2 text-[1.5rem] leading-snug text-text lg:min-h-[4.2rem]">{s.titel}</h3>
          <p class="mt-3 leading-relaxed text-text/80">{s.text}</p>
        </li>
      ))}
    </ol>
    {!kompakt && (
      <a href="/behandlung/ablauf-und-kosten/" class="knopf knopf-rand self-start mt-4">
        Ablauf und Kosten ausführlich
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    )}
  </div>
</Section>
