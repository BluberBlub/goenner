---
// Einheitlicher Einstieg aller Unterseiten (Redesign 10.11. (3), Niko: "Intro-Sektion wirkt lieblos in diesem Block").
// Keine blasse Box mehr, sondern offen gesetzt wie bei Two Chairs: oben Eyebrow und Titel über die volle Breite,
// darunter gemeinsam startend links die Einleitung in großer Schrift, rechts "Auf einen Blick" als weiße
// Karte. Die Nachbarspalte beginnt so nie auf Höhe der Headline.
import Section from '../components/Section.astro';
import SektionsKopf from '../components/SektionsKopf.astro';

interface Props { eyebrow: string; titel: string; text: string; fakten?: { k: string; v: string }[] }
const { eyebrow, titel, text, fakten = [] } = Astro.props;
---
<Section variant="kompakt" class="seiten-intro">
    <SektionsKopf eyebrow={eyebrow} titel={titel} groesse="mittel" class="!mb-0 max-w-4xl" />
    <div class="mt-10 grid gap-10 border-t border-primary/15 pt-10 lg:mt-12 lg:grid-cols-12 lg:gap-8 lg:pt-12">
      <div class:list={[fakten.length > 0 ? 'lg:col-span-7' : 'lg:col-span-9']}>
        <p data-lead class="text-xl leading-relaxed text-text sm:text-[1.4rem] sm:leading-[1.6]" set:html={text} />
        {Astro.slots.has('default') && <div class="intro-mehr mt-6 space-y-4 text-lg leading-relaxed text-text/85"><slot /></div>}
      </div>
      {fakten.length > 0 && (
        <aside class="self-start rounded-karte border border-primary/10 bg-white px-6 py-6 sm:px-8 lg:col-span-4 lg:col-start-9" aria-label="Auf einen Blick">
          <p class="etikett flex items-center gap-3 text-primary">
            <span class="w-6 border-t border-accent" aria-hidden="true"></span>Auf einen Blick
          </p>
          <dl class="fakten intro-fakten mt-4">
            {fakten.map((f) => (
              <div>
                <dt class="text-sm text-text/65">{f.k}</dt>
                <dd class="mt-1 font-display text-[1.2rem] leading-snug text-text" set:html={f.v} />
              </div>
            ))}
          </dl>
        </aside>
      )}
    </div>
</Section>
