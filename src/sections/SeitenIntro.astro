---
// Einheitliche Intro-Karte aller Unterseiten: eine Nebelkarte direkt unter dem Hero
// und verbindet ihn mit dem Inhalt. Links worum es geht, rechts versetzt "Auf einen Blick".
import SektionsKopf from '../components/SektionsKopf.astro';

interface Props { eyebrow: string; titel: string; text: string; fakten?: { k: string; v: string }[] }
const { eyebrow, titel, text, fakten = [] } = Astro.props;
---
<section class="relative z-10 pt-10 sm:pt-14">
  <div class="container">
    <div class="nebel nebel-karte grid gap-10 bg-background px-6 py-10 sm:px-10 sm:py-14 lg:grid-cols-12 lg:gap-8 lg:px-14">
      <div class="lg:col-span-7">
        <SektionsKopf eyebrow={eyebrow} titel={titel} text={text} groesse="mittel" class="!mb-0"><slot /></SektionsKopf>
      </div>
      {fakten.length > 0 && (
        <aside class="self-start lg:col-span-4 lg:col-start-9 lg:mt-24" aria-label="Auf einen Blick">
          <p class="etikett text-primary">Auf einen Blick</p>
          <dl class="fakten mt-3">
            {fakten.map((f) => (
              <div>
                <dt class="text-sm text-text/65">{f.k}</dt>
                <dd class="mt-1 font-display text-[1.2rem] leading-snug text-text" set:html={f.v} />
              </div>
            ))}
          </dl>
        </aside>
      )}
    </div>
  </div>
</section>
