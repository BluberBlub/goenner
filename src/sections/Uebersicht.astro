---
// Übersichtsseiten für die Menüpunkte mit Untermenü (Niko 10.11.).
// Jede Unterseite ist eine Wegmarke: große Ziffer, Haarlinie, Foto im ruhigen Rahmen, die drei
// wichtigsten Fakten und ein klarer Weiter-Link. Fotos wechseln die Seite, damit die Liste atmet.
import Section from '../components/Section.astro';
import Foto from '../components/Foto.astro';
import type { BildName } from '../data/bilder';

type Eintrag = { etikett: string; titel: string; text: string; href: string; link: string; bild: BildName; pos?: string; punkte?: string[] };
interface Props { eintraege: Eintrag[] }
const { eintraege } = Astro.props;
---
<Section variant="standard" bg="base">
  <ol class="space-y-20 lg:space-y-28">
    {eintraege.map((e, i) => (
      <li class="group" data-reveal>
        <div class="flex items-baseline gap-5 border-b border-primary/15 pb-4">
          <span class="font-display text-5xl italic leading-[1.15] text-accent sm:text-6xl" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="etikett text-primary">{e.etikett}</span>
        </div>
        <div class="mt-10 grid items-center gap-10 lg:grid-cols-12 lg:gap-14">
          <a href={e.href} tabindex="-1" aria-hidden="true" class:list={['block overflow-hidden rounded-karte lg:col-span-6', i % 2 ? 'lg:order-2 lg:col-start-7' : '']}>
            <Foto name={e.bild} pos={e.pos} dekorativ sizes="(min-width: 1024px) 600px, 100vw" class="block aspect-[4/3] w-full transition-transform duration-700 group-hover:scale-[1.03]" />
          </a>
          <div class:list={['lg:col-span-5', i % 2 ? 'lg:order-1 lg:col-start-1' : 'lg:col-start-8']}>
            <h2 class="text-[2rem] leading-[1.15] text-text sm:text-[2.6rem]"><a href={e.href} class="hover:text-primary" set:html={e.titel} /></h2>
            <p class="mt-5 text-lg leading-relaxed text-text/80" set:html={e.text} />
            {e.punkte && (
              <ul class="fakten mt-7">
                {e.punkte.map((p) => <li class="!py-3 leading-snug" set:html={p} />)}
              </ul>
            )}
            <a href={e.href} class="knopf knopf-rand self-start mt-8">
              {e.link}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>
        </div>
      </li>
    ))}
  </ol>
</Section>
