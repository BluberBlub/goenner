---
// Start-Hero (Referenz Octave, Leitidee Morgennebel): große Nebelfläche über die volle Hero-Höhe,
// zentrierte leichte Serif mit kursivem Akzentwort, darunter der Therapieraum im ruhigen Rahmen.
// Steht sofort da (keine Einblendung im ersten Bildschirm).
import Foto from '../components/Foto.astro';
---
<section data-hero class="relative flex min-h-[var(--hero-h)] flex-col px-3 pb-3 pt-2 sm:px-4 sm:pb-4 lg:h-[var(--hero-h)]">
  <div class="nebel nebel-karte relative flex flex-1 flex-col overflow-hidden">
    <svg class="hoehenlinien hidden text-primary sm:block" viewBox="0 0 1200 700" preserveAspectRatio="none" fill="none" aria-hidden="true">
      <g stroke="currentColor" stroke-width="1.2">
        <path d="M-20 520C180 470 320 560 520 520S880 430 1220 480" />
        <path d="M-20 560C190 510 330 600 530 560S890 470 1220 520" />
        <path d="M-20 600C200 550 340 640 540 600S900 510 1220 560" />
        <path d="M-20 140C220 110 380 180 600 150S960 90 1220 130" />
        <path d="M-20 180C230 150 390 220 610 190S970 130 1220 170" />
      </g>
    </svg>

    <div class="container relative z-10 flex flex-col items-center pt-10 text-center sm:pt-14 lg:pt-16">
      <p class="etikett flex items-center gap-3 text-primary">
        <span class="h-px w-8 bg-accent" aria-hidden="true"></span>
        Psychotherapie in Ravensburg
        <span class="h-px w-8 bg-accent" aria-hidden="true"></span>
      </p>
      <h1 class="mt-6 max-w-4xl text-[2.6rem] leading-[1.15] text-text sm:text-6xl lg:text-[4.4rem]">
        Was Sie belastet, darf einen <em>Namen</em> bekommen.
      </h1>
      <p class="lead mt-6 max-w-2xl text-lg leading-relaxed text-text/80 sm:text-xl">
        Verhaltenstherapie für Erwachsene mitten in Ravensburg: Einzel- und Gruppentherapie in einer Jugendstilvilla, mit einem Team aus vierzehn Psychologinnen und Psychologen.
      </p>
      <div class="mt-8 flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:justify-center">
        <a href="/kontakt/" class="knopf knopf-voll">
          Therapieplatz anfragen
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href="/ablauf-und-kosten/" class="knopf knopf-rand">So läuft eine Therapie ab</a>
      </div>
    </div>

    <div class="container relative z-10 mt-10 flex min-h-[12rem] flex-1 lg:mt-10">
      <div class="relative w-full overflow-hidden rounded-t-karte">
        <Foto name="therapieraum-sessel" eager sizes="(min-width: 1280px) 1200px, 100vw" pos="50% 58%"
              class="absolute inset-0 block h-full w-full" />
        <p class="absolute bottom-3 left-3 rounded-knopf bg-background/90 px-3 py-1.5 text-sm text-text/80 backdrop-blur sm:bottom-4 sm:left-4">
          Therapieraum in der Karlstraße 8
        </p>
      </div>
    </div>
  </div>
</section>
