---
// Start-Hero, Redesign 10.11. nach Two Chairs: links eine flache, satte Waldgrün-Fläche mit großer
// Serif, rechts der Therapieraum randlos bis an den Fensterrand. Keine Verläufe, keine Karte.
// Unten links beginnt die Weg-Linie (Signature), die sich durch die Startseite zieht.
// Alles im Hero steht sofort da (Kit-Regel), nur das Akzentwort stellt sich einmal scharf.
import Foto from '../components/Foto.astro';
---
<section data-hero class="hero-rund relative grid min-h-[var(--hero-h)] overflow-hidden bg-primary text-on-primary lg:h-[var(--hero-h)] lg:grid-cols-2 lg:grid-rows-1">
  <div class="relative z-10 flex flex-col justify-end px-6 pb-10 pt-28 sm:px-12 sm:py-12 lg:justify-center lg:py-10 lg:pl-[calc(max(0px,(100vw-1280px)/2)+clamp(1.5rem,5vw,4rem))] lg:pr-14">
    <p class="etikett flex items-center gap-3 text-on-primary/80">
      <span class="w-8 shrink-0 border-t border-accent" aria-hidden="true"></span>
      Verhaltenstherapie in Ravensburg
    </p>
    <h1 class="hero-titel mt-5 text-[2.35rem] min-[380px]:text-[2.6rem] lg:mt-7 leading-[1.15] sm:text-[3.6rem] lg:text-[clamp(3.2rem,4.4vw,4.8rem)]">
      Klarheit beginnt mit einem ersten Gespräch.
    </h1>
    <p class="lead hero-lead mt-5 max-w-[34rem] text-[1.05rem] lg:mt-8 lg:text-lg leading-[1.65] text-on-primary/85 sm:text-[1.3rem]">
      <span class="block [text-wrap:balance]">Einzel- und Gruppentherapie für Erwachsene mitten in Ravensburg.</span>
      <span class="mt-2 block [text-wrap:balance] text-on-primary/70">Bei uns arbeiten vierzehn Psychologinnen und Psychologen.</span>
    </p>
    <div class="mt-7 flex flex-col gap-3 sm:flex-row lg:mt-9">
      <a href="/kontakt/" class="knopf knopf-hell">
        Therapieplatz anfragen
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a href="#wegweiser" class="knopf knopf-rand-hell">Wie schnell geht es bei mir?</a>
    </div>
    <p class="mt-7 flex max-w-[34rem] items-center gap-3 border-t border-on-primary/15 pt-5 lg:mt-10 lg:pt-6 text-sm text-on-primary/80">
      <span class="relative flex h-2.5 w-2.5" aria-hidden="true"><span class="absolute inset-0 animate-ping rounded-full bg-accent/60 motion-reduce:hidden"></span><span class="relative h-2.5 w-2.5 rounded-full bg-accent"></span></span>
      Telefonische Sprechzeit donnerstags 13:00–14:00 Uhr
    </p>
  </div>

  <!-- Mobil: Bild als Hintergrund unter einer grünen Lasur, damit der Text sicher lesbar bleibt -->
  <div class="absolute inset-0 lg:relative lg:inset-auto lg:-ml-[8vw]">
    <Foto name="zweig-im-licht" eager sizes="(min-width: 1024px) 50vw, 100vw" pos="58% 50%"
          class="absolute inset-0 block h-full w-full" />
    <div class="hero-lasur absolute inset-0 lg:hidden" aria-hidden="true"></div>
    <div class="hero-uebergang absolute inset-0 hidden lg:block" aria-hidden="true"></div>
  </div>

  <!-- Beginn der Weg-Linie: kleine Schleife in der freien Ecke unten, läuft nach unten aus dem Hero -->
  <svg data-leitlinie-start class="weglinie z-20 bottom-[calc(var(--welle-h)+0.5rem)] left-[38%] hidden h-28 w-40 text-accent lg:block" viewBox="0 0 160 112" fill="none" aria-hidden="true">
    <path pathLength="1" d="M10 30C40 10 80 14 84 40c4 26-30 36-40 18-10-18 20-36 50-24 28 12 30 50 26 78" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
  </svg>
</section>
