---
// Start-Hero, Redesign 10.11. nach Two Chairs: links eine flache, satte Waldgrün-Fläche mit großer
// Serif, rechts der Therapieraum randlos bis an den Fensterrand. Keine Verläufe, keine Karte.
// Unten links beginnt die Weg-Linie (Signature), die sich durch die Startseite zieht.
// Alles im Hero steht sofort da (Kit-Regel), nur das Akzentwort stellt sich einmal scharf.
import Foto from '../components/Foto.astro';
---
<section data-hero class="relative grid min-h-[var(--hero-h)] bg-primary text-on-primary lg:h-[var(--hero-h)] lg:grid-cols-2">
  <div class="relative z-10 flex flex-col justify-center px-6 py-12 sm:px-12 lg:py-10 lg:pl-[calc(max(0px,(100vw-1280px)/2)+clamp(1.5rem,5vw,4rem))] lg:pr-14">
    <p class="etikett flex items-center gap-3 text-on-primary/80">
      <span class="w-8 border-t border-accent" aria-hidden="true"></span>
      Psychotherapie in Ravensburg
    </p>
    <h1 class="hero-titel mt-6 text-[2.6rem] leading-[1.15] sm:text-[3.6rem] lg:text-[clamp(3.2rem,4.6vw,5rem)]">
      Was Sie belastet, darf einen <em class="fokus-wort hero-em">Namen</em> bekommen.
    </h1>
    <p class="lead mt-7 max-w-xl text-lg leading-relaxed text-on-primary/85 sm:text-xl">
      Verhaltenstherapie für Erwachsene mitten in Ravensburg: Einzel- und Gruppentherapie in einer Jugendstilvilla, mit einem Team aus vierzehn Psychologinnen und Psychologen.
    </p>
    <div class="mt-9 flex flex-col gap-3 sm:flex-row">
      <a href="/kontakt/" class="knopf knopf-hell">
        Therapieplatz anfragen
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a href="#wegweiser" class="knopf knopf-rand-hell">Wie schnell geht es bei mir?</a>
    </div>
    <p class="mt-10 flex items-center gap-3 text-sm text-on-primary/80">
      <span class="relative flex h-2.5 w-2.5" aria-hidden="true"><span class="absolute inset-0 animate-ping rounded-full bg-accent/60 motion-reduce:hidden"></span><span class="relative h-2.5 w-2.5 rounded-full bg-accent"></span></span>
      Telefonische Sprechzeit donnerstags 13:00–14:00 Uhr
    </p>
  </div>

  <div class="relative min-h-[22rem] lg:min-h-0">
    <Foto name="therapieraum-sessel" eager sizes="(min-width: 1024px) 50vw, 100vw" pos="50% 60%"
          class="absolute inset-0 block h-full w-full" />
    <p class="absolute bottom-0 left-0 z-[2] bg-primary px-4 py-2.5 text-sm text-on-primary/90">
      Therapieraum in der Karlstraße 8
    </p>
  </div>

  <!-- Beginn der Weg-Linie: kleine Schleife in der freien Ecke unten, läuft nach unten aus dem Hero -->
  <svg class="weglinie z-20 bottom-0 left-[38%] hidden h-28 w-40 text-accent lg:block" viewBox="0 0 160 112" fill="none" aria-hidden="true">
    <path pathLength="1" d="M10 30C40 10 80 14 84 40c4 26-30 36-40 18-10-18 20-36 50-24 28 12 30 50 26 78" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
  </svg>
</section>
