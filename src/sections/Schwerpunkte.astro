---
// SIGNATURE MOMENT "Der Nebel lichtet sich", jetzt als Bühne zum Ausprobieren (Niko 10.11.: mutiger,
// interaktiver). Die zwölf Schwerpunkte stehen groß wie ein Satz auf Waldgrün, kommen beim
// Hineinscrollen nacheinander aus der Unschärfe (CSS .lichten). Wer ein Thema antippt oder darüber
// fährt, bekommt rechts den Namen und was dazugehört (Altseite /Behandlung/Schwerpunkte).
// Botschaft: Das Diffuse bekommt einen Namen und damit einen Weg.
import Section from '../components/Section.astro';
import Schwung from '../components/Schwung.astro';
import SektionsKopf from '../components/SektionsKopf.astro';
import { schwerpunkte } from '../data/schwerpunkte';
const nr = (i: number) => String(i + 1).padStart(2, '0');
---
<Section variant="buehne" bg="none" class="flaeche-tief overflow-clip">
  <Schwung slot="bleed" form="haken" class="right-[5%] top-10 hidden h-28 w-32 lg:block" />
  <svg slot="bleed" class="hoehenlinien text-on-primary" viewBox="0 0 1200 800" preserveAspectRatio="none" fill="none" aria-hidden="true">
    <g stroke="currentColor" stroke-width="1.2">
      <path d="M-20 120C200 80 380 170 620 120S1000 60 1220 110" />
      <path d="M-20 160C210 120 390 210 630 160S1010 100 1220 150" />
      <path d="M-20 700C220 650 400 740 640 690S1020 620 1220 670" />
    </g>
  </svg>
  <div class="grid gap-8 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <SektionsKopf
        dunkel
        eyebrow="Behandlungsschwerpunkte"
        titel="Zwölf Themen, mit denen Menschen zu uns kommen."
        text="Wir behandeln Erwachsene mit dem gesamten Spektrum psychischer Erkrankungen, bei denen eine ambulante Psychotherapie angezeigt ist. Wählen Sie ein Thema, um mehr darüber zu erfahren."
      />
    </div>
  </div>

  <!-- Mobil: jedes Thema klappt direkt an Ort und Stelle auf (keine Tafel weit unterhalb) -->
  <div class="themen-mobil mt-8 border-t border-white/15 lg:hidden">
    {schwerpunkte.map((s, i) => (
      <details class="group border-b border-white/15">
        <summary class="flex cursor-pointer list-none items-center gap-3 py-4 [&::-webkit-details-marker]:hidden">
          <span class="w-6 shrink-0 text-[.72rem] font-semibold tracking-[.1em] text-accent">{nr(i)}</span>
          <span class="flex-1 font-display text-[1.45rem] leading-snug">{s.kurz}</span>
          <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-white/25 transition-transform group-open:rotate-45" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
          </span>
        </summary>
        <div class="pb-5 pl-9 pr-2">
          <p class="font-display text-lg leading-snug text-on-secondary">{s.titel}</p>
          <p class="mt-2 leading-relaxed text-on-secondary/85">{s.text}</p>
        </div>
      </details>
    ))}
    <div class="mt-8 flex flex-col gap-3">
      <a href="/behandlung/therapie-und-schwerpunkte/#schwerpunkte" class="knopf knopf-hell">Therapie und Schwerpunkte</a>
      <a href="/behandlung/therapie-und-schwerpunkte/#gruppen" class="knopf knopf-rand-hell">Offene Gruppe für Zwänge</a>
    </div>
  </div>

  <div class="themen mt-10 hidden gap-10 lg:mt-14 lg:grid lg:grid-cols-12 lg:gap-8" data-themen>
    <ul class="lichten flex flex-wrap items-baseline gap-x-5 gap-y-2 lg:col-span-7 lg:gap-x-7" aria-label="Unsere Behandlungsschwerpunkte">
      {schwerpunkte.map((s, i) => (
        <li style={`--i:${i}`}>
          <button type="button" class="thema" data-nr={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`thema-${i}`}>
            <span class="thema-nr" aria-hidden="true">{nr(i)}</span>{s.kurz}
          </button>
        </li>
      ))}
    </ul>

    <div class="lg:col-span-5">
      <div class="thema-tafel rounded-karte lg:sticky lg:top-28" aria-live="polite">
        <div class="thema-stapel">
        {schwerpunkte.map((s, i) => (
          <article id={`thema-${i}`} class="thema-inhalt" data-aktiv={i === 0 ? '' : undefined} aria-hidden={i !== 0 ? 'true' : undefined}>
            <p class="etikett text-accent">{nr(i)} / {schwerpunkte.length}</p>
            <h3 class="mt-4 text-[1.7rem] leading-[1.2] sm:text-[2.1rem]">{s.titel}</h3>
            <p class="mt-4 text-base md:text-lg leading-relaxed opacity-90">{s.text}</p>
          </article>
        ))}
        </div>
        <div class="mt-8 flex flex-wrap gap-3 border-t border-white/15 pt-6">
          <a href="/behandlung/therapie-und-schwerpunkte/#schwerpunkte" class="knopf knopf-hell">
            Therapie und Schwerpunkte
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a href="/behandlung/therapie-und-schwerpunkte/#gruppen" class="knopf knopf-rand-hell">
            Offene Gruppe für Zwänge
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</Section>

<script>
  document.querySelectorAll<HTMLElement>('[data-themen]').forEach((box) => {
    const knoepfe = [...box.querySelectorAll<HTMLButtonElement>('.thema')];
    const inhalte = [...box.querySelectorAll<HTMLElement>('.thema-inhalt')];
    let fest = 0;
    const zeige = (n: number) => {
      knoepfe.forEach((k, i) => k.setAttribute('aria-pressed', String(i === n)));
      inhalte.forEach((el, i) => {
        if (i === n) { el.removeAttribute('aria-hidden'); el.setAttribute('data-aktiv', ''); el.classList.remove('thema-neu'); void el.offsetWidth; el.classList.add('thema-neu'); }
        else { el.setAttribute('aria-hidden', 'true'); el.removeAttribute('data-aktiv'); el.classList.remove('thema-neu'); }
      });
    };
    const fein = matchMedia('(hover: hover) and (pointer: fine)').matches;
    knoepfe.forEach((k, i) => {
      k.addEventListener('click', () => { fest = i; zeige(i); });
      if (fein) k.addEventListener('pointerenter', () => zeige(i));
    });
    box.querySelector('ul')?.addEventListener('pointerleave', () => { if (fein) zeige(fest); });
  });
</script>
