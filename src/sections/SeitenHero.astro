---
// Unterseiten-Hero, Redesign 10.11. (Referenz Two Chairs): gleiche Familie wie der Start-Hero.
// Links eine flache Waldgrün-Fläche mit Brotkrumen, Titel und Einleitung, rechts das Foto randlos und
// unverdunkelt (Niko: Texte lesbar, Fotos nicht abdunkeln). Höhe = Fenster minus Navigation, steht sofort da.
// Mobil (10.11.): Foto als Hintergrund unter der Waldgrün-Lasur wie auf der Startseite.
// Props wie PageHero (title, subtitle, image, imagePosition, eyebrow) plus pfad.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Schwung from '../components/Schwung.astro';

interface Props { title: string; subtitle?: string; image: string; imagePosition?: string; eyebrow?: string; pfad?: { label: string; href: string }[] }
const { title, subtitle, image, imagePosition = '50% 50%', eyebrow, pfad = [] } = Astro.props;
const variante = (p: string, ext: string) => {
  const m = /^(\/.+)\.(jpe?g|png|webp|avif)$/i.exec(p || '');
  if (!m) return undefined;
  const da = (x: string) => existsSync(join(process.cwd(), 'public', x));
  const gross = `${m[1]}.${ext}`, klein = `${m[1]}-800.${ext}`;
  if (da(klein) && da(gross)) return `${klein} 800w, ${gross} 1600w`;
  return da(gross) ? `${gross} 1600w` : undefined;
};
const avif = variante(image, 'avif');
const webp = variante(image, 'webp');
---
<section data-hero class="seiten-hero hero-rund relative grid min-h-[var(--hero-h)] overflow-hidden bg-primary text-on-primary lg:grid-cols-2 lg:grid-rows-1">
  <div class="relative z-10 flex flex-col justify-end px-6 pb-10 pt-28 sm:px-12 sm:pb-14 sm:pt-32 lg:justify-center lg:py-12 lg:pl-[calc(max(0px,(100vw-1280px)/2)+clamp(1.5rem,5vw,4rem))] lg:pr-14">
    {pfad.length > 0 && (
      <nav aria-label="Brotkrumen" class="mb-6 text-sm text-on-primary/85">
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
          {pfad.map((p) => (
            <li class="flex items-center gap-2">
              <a href={p.href} class="underline decoration-on-primary/40 underline-offset-4 hover:decoration-accent">{p.label}</a>
              <span aria-hidden="true" class="text-accent">/</span>
            </li>
          ))}
          <li aria-current="page" class="text-on-primary" set:html={eyebrow || ''} />
        </ol>
      </nav>
    )}
    {eyebrow && pfad.length === 0 && (
      <p class="etikett mb-5 flex items-center gap-3 text-on-primary/85" data-eyebrow>
        <span class="w-8 shrink-0 border-t border-accent" aria-hidden="true"></span><span set:html={eyebrow} />
      </p>
    )}
    <h1 class="hero-titel text-[2.2rem] leading-[1.15] min-[380px]:text-[2.5rem] sm:text-[3.4rem] lg:text-[clamp(3rem,4.2vw,4.4rem)]" set:html={title} />
    {subtitle && <p data-lead class="mt-6 max-w-xl text-lg leading-relaxed text-on-primary/85 sm:text-xl" set:html={subtitle} />}
    <slot />
  </div>
  <div class="hero-bild absolute inset-0 overflow-hidden bg-secondary lg:relative lg:inset-auto lg:h-auto lg:-ml-[8vw]">
    <picture>
      {avif && <source type="image/avif" srcset={avif} sizes="(min-width: 1024px) 50vw, 100vw" />}
      {webp && <source type="image/webp" srcset={webp} sizes="(min-width: 1024px) 50vw, 100vw" />}
      <img src={image} alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover"
           style={`object-position:${imagePosition}`} width="1920" height="1080" loading="eager" fetchpriority="high" decoding="async" />
    </picture>
    <div class="hero-lasur absolute inset-0 lg:hidden" aria-hidden="true"></div>
    <div class="hero-uebergang absolute inset-0 hidden lg:block" aria-hidden="true"></div>
  </div>
  <Schwung form="schleife" zeichnen={false} class="z-20 bottom-8 left-[calc(50%-8vw-3rem)] hidden h-20 w-28 lg:block" />
</section>
