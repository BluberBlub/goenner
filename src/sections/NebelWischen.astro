---
// Interaktiver Nebel über einem Foto (Leitidee "Morgennebel, der sich lichtet").
// Botschaft: Was diffus ist, bekommt Kontur, sobald man sich ihm zuwendet. Der Zeiger (Maus oder
// Finger) wischt den Nebel beiseite, er zieht langsam wieder zu. Ohne Zeiger wandert eine ruhige
// Lichtung von selbst über das Bild. Das Foto scheint immer durch (Nebel nie deckend).
// Bei "Bewegung reduzieren" oder ohne JS gibt es keinen Nebel, das Foto steht klar da.
// Parent muss position:relative + overflow:hidden haben. Liegt unter Text-Ebenen (z-index 1).
interface Props { dichte?: number; class?: string }
const { dichte = 0.62, class: cls = '' } = Astro.props;
---
<canvas data-nebel data-dichte={dichte} class:list={['nebel-wischen', cls]} aria-hidden="true"></canvas>

<script>
  const reduziert = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLCanvasElement>('canvas[data-nebel]').forEach((cv) => {
    if (reduziert) return;
    const ctx = cv.getContext('2d');
    const host = cv.parentElement;
    if (!ctx || !host) return;
    const basis = Math.min(0.85, Math.max(0.2, Number(cv.dataset.dichte) || 0.62));
    const Z = 7; // Pixel pro Nebelzelle: grob rechnen, per CSS weich skalieren
    let w = 0, h = 0, a = new Float32Array(0), rausch = new Float32Array(0), bild: ImageData;
    const farbe = getComputedStyle(document.documentElement).getPropertyValue('--color-background-rgb').trim().split(/\s+/).map(Number);
    const [fr, fg, fb] = farbe.length === 3 && farbe.every((x) => !isNaN(x)) ? farbe : [247, 249, 244];

    const groesse = () => {
      const r = host.getBoundingClientRect();
      const nw = Math.max(8, Math.ceil(r.width / Z)), nh = Math.max(8, Math.ceil(r.height / Z));
      if (nw === w && nh === h) return;
      w = nw; h = nh; cv.width = w; cv.height = h;
      a = new Float32Array(w * h).fill(basis);
      rausch = new Float32Array(w * h);
      for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) {
        // weiche Schwaden: Summe zweier Wellen, ohne Bibliothek
        rausch[y * w + x] = 0.5 + 0.25 * Math.sin(x * 0.11 + Math.sin(y * 0.07) * 2) + 0.25 * Math.sin(y * 0.09 - x * 0.04);
      }
      bild = ctx.createImageData(w, h);
    };
    groesse();
    new ResizeObserver(groesse).observe(host);

    let px = -1, py = -1, zuletzt = 0, sichtbar = true, t = 0;
    const zeiger = (e: PointerEvent) => {
      const r = cv.getBoundingClientRect();
      px = (e.clientX - r.left) / Z; py = (e.clientY - r.top) / Z; zuletzt = performance.now();
    };
    host.addEventListener('pointermove', zeiger, { passive: true });
    host.addEventListener('pointerdown', zeiger, { passive: true });
    new IntersectionObserver(([e]) => { sichtbar = e.isIntersecting; }).observe(host);

    const lichten = (cx: number, cy: number, rad: number, kraft: number) => {
      const r2 = rad * rad;
      const x0 = Math.max(0, Math.floor(cx - rad)), x1 = Math.min(w - 1, Math.ceil(cx + rad));
      const y0 = Math.max(0, Math.floor(cy - rad)), y1 = Math.min(h - 1, Math.ceil(cy + rad));
      for (let y = y0; y <= y1; y++) for (let x = x0; x <= x1; x++) {
        const d = ((x - cx) ** 2 + (y - cy) ** 2) / r2;
        if (d < 1) { const i = y * w + x; a[i] = Math.max(0, a[i] - kraft * (1 - d) * (1 - d)); }
      }
    };

    let vorher = 0;
    const schritt = (jetzt: number) => {
      requestAnimationFrame(schritt);
      if (!sichtbar || jetzt - vorher < 33) return; // 30 fps reichen für Nebel
      const dt = Math.min(0.1, (jetzt - vorher) / 1000); vorher = jetzt; t += dt;
      const rad = Math.max(w, h) * 0.2;
      if (jetzt - zuletzt < 2500 && px >= 0) lichten(px, py, rad, 0.5);
      else {
        // ruhige Lichtung, die von selbst über das Bild wandert
        lichten(w * (0.5 + 0.32 * Math.sin(t * 0.23)), h * (0.5 + 0.28 * Math.sin(t * 0.31 + 1)), rad * 1.15, 0.08);
      }
      const drift = t * 3;
      const d = bild.data;
      for (let i = 0, n = w * h; i < n; i++) {
        const x = i % w, y = (i / w) | 0;
        const ziel = basis * (0.55 + 0.6 * rausch[y * w + ((x + (drift | 0)) % w)]);
        a[i] += (ziel - a[i]) * dt * 0.35; // zieht langsam wieder zu
        const o = i * 4;
        d[o] = fr; d[o + 1] = fg; d[o + 2] = fb; d[o + 3] = Math.min(235, a[i] * 255);
      }
      ctx.putImageData(bild, 0, 0);
    };
    cv.classList.add('ist-aktiv');
    requestAnimationFrame(schritt);
  });
</script>
