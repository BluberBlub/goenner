---
// @LOCKED v3 – Wiederverwendbare CTA-Sektion vor dem Footer.
// v2 (Opitz-Learning): eigenständige Karte auf neutralem Grund mit klarem Abstand
// zum Footer. Nichts ragt hinein, nichts verschmilzt. Schriftfarben automatisch
// nach Kontrast (text-on-primary / text-on-accent). titel/text dürfen &nbsp; und <br> enthalten.
// v3 (Weber): jeder weitere Satz im Text beginnt in einer neuen Zeile (nie mitten im Satz
//     umbrechen), Radius aus design.radius. Regel: je Seite eigener Titel, Text und Button-Text.
// Props: titel, text?, buttonText?, buttonHref?, telefonZeigen?
import siteData from '../content/site-data.json';
interface Props { titel: string; text?: string; buttonText?: string; buttonHref?: string; telefonZeigen?: boolean; }
const { titel, text, buttonText = 'Termin vereinbaren', buttonHref = '/kontakt/', telefonZeigen = true } = Astro.props;
const tel = siteData.kontakt?.telefon;
// Satzende + neuer Satz -> Zeilenumbruch (nicht in Abkürzungen wie "z. B." oder Zahlen)
const ABK = /^(bzw|inkl|evtl|ggf|tel|str|usw|ca|nr|mo|di|mi|do|fr|sa|so|zzgl|exkl|vgl|bspw|hr|dr|z\.b|u\.a|d\.h|st|gmbh|e\.k|\d+)\.$/i;
const textZeilen = text ? text.replace(/(\S+[.!?])\s+(?=[A-ZÄÖÜ])/g, (m, wort) => (ABK.test(wort.replace(/^[^\wäöüß]+/i, '')) ? m : `${wort}<br />`)) : '';
const telHref = (t) => { let s = String(t).replace(/\(0\)/g, '').replace(/[^\d+]/g, ''); if (s.startsWith('00')) s = '+' + s.slice(2); else if (s.startsWith('0')) s = ({ AT: '+43', CH: '+41' }[siteData.kontakt?.land] || '+49') + s.slice(1); return `tel:${s}`; };
---
<section class="bg-background pt-12 sm:pt-16 lg:pt-20 pb-16 sm:pb-20 lg:pb-24" data-cta>
  <div class="container">
    <div class="relative overflow-hidden isolate bg-primary text-on-primary rounded-[var(--radius-karte,1.5rem)] shadow-2xl
                px-7 py-10 sm:p-10 lg:px-14 lg:py-14
                lg:flex lg:items-center lg:justify-between lg:gap-10 text-center lg:text-left">
      <div aria-hidden="true" class="pointer-events-none absolute -z-10 -top-24 -right-20 w-72 h-72 rounded-full bg-accent/30 blur-3xl"></div>
      <div aria-hidden="true" class="pointer-events-none absolute -z-10 -bottom-28 -left-16 w-64 h-64 rounded-full bg-on-primary/10 blur-3xl"></div>
      <div class="max-w-2xl mx-auto lg:mx-0">
        <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl font-bold" set:html={titel} />
        {text && <p data-lead class="mt-3 text-on-primary/80" set:html={textZeilen} />}
        {telefonZeigen && tel && (
          <p class="mt-2 text-on-primary/80">
            Oder direkt anrufen: <a href={telHref(tel)} class="font-semibold underline underline-offset-4 decoration-accent decoration-2 whitespace-nowrap hover:text-on-primary">{tel}</a>
          </p>
        )}
      </div>
      <a href={buttonHref}
         class="mt-7 lg:mt-0 shrink-0 inline-flex items-center justify-center gap-2 bg-accent text-on-accent font-semibold
                px-8 py-4 rounded-[var(--radius-knopf,9999px)] shadow-lg hover:-translate-y-0.5 hover:shadow-xl transition">
        {buttonText}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </div>
</section>
