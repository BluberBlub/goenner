---
// @LOCKED v1 – Google-Karte, an die Cookie-Einwilligung gekoppelt (Schwabenpflege, Niko: "Karte mit
// Cookie-Meldung gekoppelt muss immer DSGVO sein, Rechtssicherheit oberstes Maß").
// - Ohne Einwilligung wird NICHTS von Google geladen: gestaltete Fläche mit Adresse, Hinweis und Routenlink.
// - "Alle akzeptieren" im Cookie-Hinweis zeigt die Karte sofort (ohne Neuladen), "Karte laden" speichert
//   dieselbe Einwilligung. Widerruf direkt an der Karte und über "Cookie-Einstellungen" im Footer.
// - Pflicht in site-data.json: "externeInhalte": ["Google Maps"] (qa-checks prüft das) und ein
//   Google-Maps-Abschnitt in der Datenschutzerklärung.
// Props: adresse (Standard: Firma, Straße, PLZ Ort aus site-data), titel, class
import siteData from '../content/site-data.json';
interface Props { adresse?: string; titel?: string; class?: string }
const k = siteData.kontakt || {};
const standard = [siteData.meta?.firmenname, k.strasse, `${k.plz || ''} ${k.ort || ''}`.trim()].filter(Boolean).join(', ');
const { adresse = standard, titel = 'Karte', class: cls = '' } = Astro.props;
const q = encodeURIComponent(adresse);
const embed = `https://www.google.com/maps?q=${q}&output=embed`;
const route = `https://www.google.com/maps/dir/?api=1&destination=${q}`;
const [kopf, ...rest] = adresse.split(', ');
---
<div class:list={['karte-laden relative overflow-hidden rounded-[var(--radius-karte,1.5rem)] bg-primary text-on-primary', cls]} data-embed={embed} data-titel={titel}>
  <div class="karte-platz flex h-full min-h-[20rem] flex-col items-start justify-end gap-4 p-7 sm:min-h-[24rem] sm:p-9">
    <svg class="pointer-events-none absolute inset-0 h-full w-full opacity-[0.08]" aria-hidden="true" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice">
      <g fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M0 210 C 80 190 120 240 200 215 S 330 160 400 180" /><path d="M40 0 L 120 300" /><path d="M260 0 L 230 300" />
        <path d="M0 90 L 400 120" /><path d="M300 0 C 320 80 380 120 400 130" />
      </g>
    </svg>
    <p class="relative font-display text-lg font-bold sm:text-xl">{rest.length > 1 ? <>{kopf}<br /><span class="whitespace-nowrap">{rest[0]},</span> <span class="whitespace-nowrap">{rest.slice(1).join(', ')}</span></> : adresse}</p>
    <p class="relative max-w-md text-sm text-on-primary/80">Mit Ihrer Einwilligung („Alle akzeptieren“ im Cookie-Hinweis oder „Karte laden“) zeigen wir hier Google Maps. Dabei werden Daten an Google übertragen. Mehr dazu in der <a href="/datenschutz/" class="underline underline-offset-2">Datenschutzerklärung</a>.</p>
    <div class="relative flex flex-col gap-3 sm:flex-row">
      <button type="button" class="karte-knopf inline-flex items-center justify-center bg-accent text-on-accent font-semibold px-6 py-3 rounded-[var(--radius-knopf,9999px)] hover:-translate-y-0.5 transition">Karte laden</button>
      <a href={route} target="_blank" rel="noopener" class="inline-flex items-center justify-center border border-on-primary/50 font-semibold px-6 py-3 rounded-[var(--radius-knopf,9999px)] hover:bg-on-primary/10 transition">Route planen</a>
    </div>
  </div>
</div>

<script>
  const zustimmung = () => { try { return localStorage.getItem('cookie-consent') === 'all'; } catch { return false; } };
  const setze = (wert: string) => {
    try { localStorage.setItem('cookie-consent', wert); } catch {}
    document.getElementById('cookie-banner')?.classList.add('hidden');
    window.dispatchEvent(new CustomEvent('cookieconsent', { detail: wert }));
  };
  document.querySelectorAll<HTMLElement>('.karte-laden').forEach((box) => {
    const platz = box.querySelector('.karte-platz');
    const laden = () => {
      if (box.querySelector('iframe')) return;
      const f = document.createElement('iframe');
      f.src = box.dataset.embed || '';
      f.title = box.dataset.titel || 'Karte';
      f.loading = 'lazy';
      f.referrerPolicy = 'no-referrer-when-downgrade';
      f.className = 'block h-full min-h-[24rem] w-full border-0';
      const widerruf = document.createElement('button');
      widerruf.type = 'button';
      widerruf.dataset.widerruf = '';
      widerruf.className = 'absolute bottom-3 left-3 rounded-[var(--radius-knopf,9999px)] bg-background/95 px-3 py-1.5 text-xs font-semibold text-primary shadow-md hover:bg-background';
      widerruf.textContent = 'Karte ausblenden (Einwilligung widerrufen)';
      widerruf.addEventListener('click', () => setze('essential'));
      platz?.classList.add('hidden');
      box.append(f, widerruf);
    };
    const entfernen = () => {
      box.querySelectorAll('iframe, [data-widerruf]').forEach((e) => e.remove());
      platz?.classList.remove('hidden');
    };
    box.querySelector('.karte-knopf')?.addEventListener('click', () => { setze('all'); laden(); });
    window.addEventListener('cookieconsent', (e) => ((e as CustomEvent).detail === 'all' ? laden() : entfernen()));
    if (zustimmung()) laden();
  });
</script>
