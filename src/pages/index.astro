---
import Seite from '../layouts/Seite.astro';
import Section from '../components/Section.astro';
import SektionsKopf from '../components/SektionsKopf.astro';
import Fragen from '../components/Fragen.astro';
import Abschluss from '../sections/Abschluss.astro';
import StartHero from '../sections/StartHero.astro';
import Schwerpunkte from '../sections/Schwerpunkte.astro';
import Wartezeit from '../sections/Wartezeit.astro';
import Weg from '../sections/Weg.astro';
import TeamAnriss from '../sections/TeamAnriss.astro';
import { fragenStart } from '../data/fragen';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: fragenStart.map((q) => ({ '@type': 'Question', name: q.f, acceptedAnswer: { '@type': 'Answer', text: q.a.replace(/<[^>]+>/g, '') } })),
};
---
<Seite
  title="Psychotherapie in Ravensburg | Praxis Dr. Gönner"
  description="Verhaltenstherapie für Erwachsene in Ravensburg: Einzel- und Gruppentherapie, AOK- und BKK-Verträge, Supervision und Lehrpraxis. Karlstraße 8, alle Kassen."
  lcpName="zweig-im-licht"
  lcpSizes="(min-width: 1024px) 50vw, 100vw"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <StartHero />
  <Wartezeit />
  <Schwerpunkte />
  <Weg />
  <TeamAnriss />
  <Section variant="standard" bg="base">
    <SektionsKopf eyebrow="Häufige Fragen" titel="Was Sie vor dem ersten Termin wissen sollten." />
    <Fragen fragen={fragenStart} />
  </Section>
  <Abschluss
    titel="Der erste Schritt darf klein sein."
    text="Schreiben Sie uns über das Kontaktformular. Wir melden uns innerhalb von zwei Wochen, wenn wir Ihnen ein Vorgespräch anbieten können."
    buttonText="Therapieplatz anfragen"
    buttonHref="/kontakt/"
    telefonZeigen={false}
  />
</Seite>
