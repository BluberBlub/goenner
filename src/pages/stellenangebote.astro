---
import Seite from '../layouts/Seite.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import SektionsKopf from '../components/SektionsKopf.astro';
import Cta from '../components/Cta.astro';
import SeitenIntro from '../sections/SeitenIntro.astro';

const geboten = [
  'ein unbefristetes Arbeitsverhältnis',
  'Bezahlung orientiert am Tarif des öffentlichen Dienstes',
  'flexible Arbeitszeit- und Urlaubsplanung',
  'regelmäßige praxisinterne Intervision (von der LPK BW akkreditiert)',
  'die Möglichkeit, Therapiegruppen anzubieten',
  'ein vielfältiges Behandlungsspektrum, in dem Sie nach eigenen Interessen Schwerpunkte setzen können',
  'Parkplätze für Mitarbeiterinnen und Mitarbeiter',
  'großzügige, helle und modern eingerichtete Räume in einer Jugendstilvilla',
  'Innenstadtlage, nur fünf Gehminuten zum Bahnhof',
];
const stelle = {
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: 'Psychologische Psychotherapeutin / Psychologischer Psychotherapeut (w/m/d) in Festanstellung',
  description: 'Psychologische Psychotherapeutin oder Psychologischer Psychotherapeut mit Fachkunde in Verhaltenstherapie für die Praxis Dr. Sascha Gönner in Ravensburg. Unbefristet, Bezahlung orientiert am TVöD, Teilzeit möglich.',
  employmentType: ['FULL_TIME', 'PART_TIME'],
  datePosted: '2026-11-09',
  hiringOrganization: { '@type': 'Organization', name: 'Praxis für Psychotherapie Dr. Sascha Gönner', sameAs: 'https://goenner.niko-endres.de' },
  jobLocation: { '@type': 'Place', address: { '@type': 'PostalAddress', streetAddress: 'Karlstraße 8', postalCode: '88212', addressLocality: 'Ravensburg', addressCountry: 'DE' } },
};
---
<Seite
  title="Stellenangebot Psychotherapeut Ravensburg | Dr. Gönner"
  description="Wir suchen eine Psychologische Psychotherapeutin oder einen Psychologischen Psychotherapeuten mit Fachkunde Verhaltenstherapie in Festanstellung in Ravensburg."
  lcpBild="/images/kunst-ausstellung-zollmann.jpg"
  lcpVarianten
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(stelle)} />
  <PageHero
    eyebrow="Stellenangebote"
    title="Verstärken Sie unser Team."
    subtitle="Psychologische Psychotherapeutin oder Psychologischer Psychotherapeut in Festanstellung (w/m/d)."
    image="/images/kunst-ausstellung-zollmann.jpg"
    imagePosition="50% 40%"
  />
  <SeitenIntro
    eyebrow="Festanstellung in Ravensburg"
    titel="Psychologische Psychotherapeutin oder Psychotherapeut mit Fachkunde <em>Verhaltenstherapie</em>."
    text="Für unsere Praxis in Ravensburg suchen wir Verstärkung. Bewerben können sich auch frisch approbierte oder erfahrene Kolleginnen und Kollegen, die in Teilzeit arbeiten möchten. Wir arbeiten Sie sorgfältig in die Praxisabläufe ein."
    fakten={[
      { k: 'Beginn', v: 'nach Vereinbarung' },
      { k: 'Umfang', v: 'nach Vereinbarung, Teilzeit möglich' },
      { k: 'Vertrag', v: 'unbefristet' },
    ]}
  />
  <Section variant="standard" bg="base">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7">
        <SektionsKopf eyebrow="Was wir bieten" titel="Gute Bedingungen für <em>gute</em> Therapie." groesse="mittel" />
        <ul class="grid gap-x-8 sm:grid-cols-2">
          {geboten.map((g) => <li class="border-t border-primary/15 py-4 leading-relaxed" data-reveal>{g}</li>)}
        </ul>
      </div>
      <aside class="self-start lg:col-span-4 lg:col-start-9 lg:mt-24">
        <div class="rounded-karte bg-primary p-8 text-on-primary sm:p-10">
          <p class="etikett opacity-80">Bewerbung</p>
          <p class="mt-4 font-display text-[1.5rem] leading-snug">Wir freuen uns auf Ihre Bewerbung, gern per E-Mail oder Post.</p>
          <address class="mt-6 not-italic leading-relaxed opacity-95">
            Dr. phil. Sascha Gönner<br />Karlstraße 8<br />88212 Ravensburg<br />
            Telefon <a href="tel:+4975197719730" class="underline underline-offset-4">0751 9771973-0</a><br />
            <a href="mailto:praxis@drgoenner.de" class="font-semibold underline decoration-accent decoration-2 underline-offset-4">praxis@drgoenner.de</a>
          </address>
        </div>
      </aside>
    </div>
  </Section>
  <Cta
    titel="Fragen zur Stelle?"
    text="Schreiben Sie uns gern vorab, wir antworten persönlich."
    buttonText="Nachricht schreiben"
    buttonHref="mailto:praxis@drgoenner.de"
  />
</Seite>
