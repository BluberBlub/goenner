---
import Seite from '../../layouts/Seite.astro';
import SeitenHero from '../../sections/SeitenHero.astro';
import Section from '../../components/Section.astro';
import SektionsKopf from '../../components/SektionsKopf.astro';
import Fragen from '../../components/Fragen.astro';
import Abschluss from '../../sections/Abschluss.astro';
import SeitenIntro from '../../sections/SeitenIntro.astro';

const fragen = [
  { f: 'Wer kann die Verträge nutzen?', a: '<p>Gesetzlich Versicherte, die am Hausarztvertrag der AOK Baden-Württemberg teilnehmen, und Versicherte einer Betriebskrankenkasse, die am BKK-Selektivvertrag teilnimmt. Welche Betriebskrankenkassen dabei sind, steht in der <a class="underline underline-offset-4" href="https://www.medi-verbund.de/wp-content/uploads/2022/06/2026-01-01_Anlage-10-Liste-der-am-Vertrag-teilnehmenden-BKK.pdf" target="_blank" rel="noopener">Liste der teilnehmenden BKK (PDF, MEDI Verbund)</a>.</p>' },
  { f: 'Warum geht es mit diesen Verträgen schneller?', a: '<p>Patientinnen und Patienten aus diesen Verträgen behandeln wir außerhalb unseres durch die Kassenärztliche Vereinigung begrenzten Kontingents an Behandlungsplätzen. Deshalb bekommen Sie innerhalb von zwei Wochen einen Vorgesprächstermin und in der Regel auch früher einen Therapieplatz.</p>' },
  { f: 'Muss ich mich vorher einschreiben?', a: '<p>Die Einschreibung in die Verträge ist direkt in unserer Praxis möglich. Als AOK-Versicherte oder AOK-Versicherter müssen Sie dafür bereits am AOK-Hausarztvertrag teilnehmen.</p>' },
  { f: 'Was brauche ich für den ersten Termin?', a: '<p>Ihre Versichertenkarte und, falls vorhanden, Arzt- oder Klinikberichte. Wer am Hausarzt- oder Facharztprogramm der AOK teilnimmt, braucht zusätzlich eine Überweisung des Hausarztes.</p>' },
];
---
<Seite
  title="AOK-Facharztvertrag und BKK-Vertrag | Praxis Dr. Gönner"
  description="AOK-Hausarztvertrag oder BKK-Selektivvertrag? Dann bekommen Sie in unserer Praxis für Psychotherapie in Ravensburg innerhalb von zwei Wochen ein Vorgespräch."
  lcpBild="/images/kunst-spiegel.jpg"
  lcpVarianten
>
  <SeitenHero
    pfad={[{ label: 'Behandlung', href: '/behandlung/' }]}
    eyebrow="AOK Baden-Württemberg und BKK"
    title="Vorgespräch innerhalb von zwei&nbsp;Wochen."
    subtitle="Mit dem Facharztvertrag der AOK Baden-Württemberg und dem BKK-Selektivvertrag."
    image="/images/hero-see.jpg"
    imagePosition="50% 50%"
  />
  <SeitenIntro
    eyebrow="Facharztvertrag und Selektivvertrag"
    titel="Ein schnellerer Weg für viele gesetzlich Versicherte."
    text="Nehmen Sie am Hausarztvertrag der AOK Baden-Württemberg teil oder sind Sie bei einer Betriebskrankenkasse versichert, die am BKK-Selektivvertrag teilnimmt? Dann können Sie die Vorteile dieser Verträge nutzen und bekommen innerhalb von zwei Wochen einen Vorgesprächstermin in unserer Praxis."
    fakten={[
      { k: 'Vorgespräch', v: 'innerhalb von zwei Wochen' },
      { k: 'Therapieplatz', v: 'in der Regel früher' },
      { k: 'Einschreibung', v: 'direkt in unserer Praxis' },
    ]}
  />
  <Section variant="standard" bg="base">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-5">
        <SektionsKopf eyebrow="Fragen zu den Verträgen" titel="Was Sie zu den Verträgen wissen sollten." groesse="mittel" />
      </div>
      <div class="lg:col-span-7">
        <Fragen fragen={fragen} />
      </div>
    </div>
  </Section>
  <Abschluss
    titel="Sie nutzen einen der Verträge?"
    text="Dann können Sie direkt ein Vorgespräch vereinbaren. Wählen Sie im Formular einfach Ihren Versicherungsstatus aus."
    buttonText="Vorgespräch vereinbaren"
    buttonHref="/kontakt/"
    telefonZeigen={false}
  />
</Seite>
