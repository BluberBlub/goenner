---
import Seite from '../../../layouts/Seite.astro';
import SeitenHero from '../../../sections/SeitenHero.astro';
import Section from '../../../components/Section.astro';
import SektionsKopf from '../../../components/SektionsKopf.astro';
import Abschluss from '../../../sections/Abschluss.astro';
import Foto from '../../../components/Foto.astro';
import { stellen } from '../../../data/stellen';

const gruende = [
  { t: 'Ein großes Team', a: 'Zehn approbierte Psychotherapeutinnen und Psychotherapeuten und vier Psychologinnen und Psychologen in Ausbildung unter einem Dach.' },
  { t: 'Fachlicher Austausch', a: 'Regelmäßige praxisinterne Intervision, von der Landespsychotherapeutenkammer Baden-Württemberg akkreditiert.' },
  { t: 'Raum für Schwerpunkte', a: 'Ein vielfältiges Behandlungsspektrum, eigene Therapiegruppen und Schwerpunkte nach Ihren Interessen.' },
];
---
<Seite
  title="Stellenangebote Psychotherapie Ravensburg | Praxis Dr. Gönner"
  description="Offene Stellen in der Praxis Dr. Sascha Gönner in Ravensburg: Psychologische Psychotherapeutin oder Psychotherapeut (w/m/d) mit Fachkunde Verhaltenstherapie, unbefristet, Teilzeit möglich."
  lcpBild="/images/therapieraum-sessel.jpg"
  lcpVarianten
>
  <SeitenHero
    pfad={[{ label: 'Fachliches', href: '/fachliches/' }]}
    eyebrow="Stellenangebote"
    title="Arbeiten in der Villa."
    subtitle="Offene Stellen in unserer Praxis für Verhaltenstherapie mitten in Ravensburg."
    image="/images/therapieraum-sessel.jpg"
    imagePosition="50% 60%"
  />

  <Section variant="standard" bg="base">
    <SektionsKopf eyebrow={`${stellen.length === 1 ? 'Eine offene Stelle' : `${stellen.length} offene Stellen`}`} titel="Wen wir suchen." />
    <ul class="space-y-6">
      {stellen.map((s) => (
        <li>
          <a href={`/fachliches/stellenangebote/${s.slug}/`} class="stelle-karte nebel nebel-karte group grid gap-8 p-7 sm:p-10 lg:grid-cols-12 lg:items-end lg:gap-10 lg:p-14">
            <div class="lg:col-span-8">
              <p class="etikett flex items-center gap-3 text-primary"><span class="h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>Jetzt offen</p>
              <h2 class="mt-5 text-[1.9rem] leading-[1.15] text-text sm:text-[2.6rem]">{s.titel}</h2>
              <p class="mt-3 font-display text-xl italic text-primary">{s.kurz}</p>
              <p class="mt-5 max-w-2xl text-lg leading-relaxed text-text/80">{s.text}</p>
              <ul class="mt-7 flex flex-wrap gap-2.5">
                {s.fakten.map((f) => <li class="rounded-knopf border border-primary/20 bg-white/70 px-3.5 py-1.5 text-[.95rem] text-text">{f}</li>)}
              </ul>
            </div>
            <div class="lg:col-span-4 lg:text-right">
              <span class="knopf knopf-voll">
                Zur Stellenanzeige
                <svg class="transition-transform group-hover:translate-x-1" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <Section variant="standard" bg="tint">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-5">
        <div class="overflow-hidden rounded-karte">
          <Foto name="praxis-flur" sizes="(min-width: 1024px) 520px, 100vw" pos="50% 55%" class="block aspect-[4/5] w-full" />
        </div>
      </div>
      <div class="lg:col-span-6 lg:col-start-7 lg:self-center">
        <SektionsKopf eyebrow="Warum bei uns" titel="Gute Bedingungen für gute Therapie." groesse="mittel" />
        <ol>
          {gruende.map((g, i) => (
            <li class="grid grid-cols-[3rem_1fr] gap-4 border-t border-primary/15 py-6" data-reveal>
              <span class="font-display text-3xl italic leading-[1.15] text-accent" aria-hidden="true">{i + 1}</span>
              <div>
                <h3 class="text-[1.45rem] leading-snug text-text">{g.t}</h3>
                <p class="mt-2 leading-relaxed text-text/80">{g.a}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </Section>

  <Abschluss
    etikett="Bewerbung"
    titel="Wir freuen uns auf Ihre Bewerbung."
    text="Gern per E-Mail oder Post. Fragen zur Stelle beantworten wir vorab persönlich."
    buttonText="Bewerbung per E-Mail"
    buttonHref="mailto:praxis@drgoenner.de?subject=Bewerbung"
    wege={[
      { titel: 'Per E-Mail', text: 'praxis@drgoenner.de', href: 'mailto:praxis@drgoenner.de?subject=Bewerbung', link: 'E-Mail schreiben' },
      { titel: 'Per Post', text: 'Dr. phil. Sascha Gönner<br />Karlstraße 8, 88212 Ravensburg' },
      { titel: 'Telefonisch', text: 'Bei Fragen zur Stelle: 0751 9771973-0', href: 'tel:+4975197719730', link: 'Anrufen' },
    ]}
  />
</Seite>
